# Next.js application
NEXT_PUBLIC_CONVEX_URL=

# Convex Auth. Configure these in the Convex deployment environment.
CONVEX_SITE_URL=
DASHBOARD_OWNER_EMAIL=scott@cherrycapitalweb.com
DASHBOARD_OWNER_PASSWORD=

# Convex Auth also provisions JWT_PRIVATE_KEY and JWKS. Do not hand-edit them
# unless you are deliberately rotating the deployment's signing keys.

# Vercel AI Gateway (preferred). OPENAI_API_KEY is also supported by the SDK.
AI_GATEWAY_API_KEY=
# OPENAI_API_KEY=
# AI_CHAT_MODEL=openai/gpt-4o-mini

# Server-side contact delivery
WEB3FORMS_ACCESS_KEY=

# Optional direct company-information email delivery
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Cherry Capital <hello@yourdomain.com>

# Analytics ingestion. Use different high-entropy values.
ANALYTICS_INGEST_SECRET=
VERCEL_ANALYTICS_DRAIN_SECRET=
